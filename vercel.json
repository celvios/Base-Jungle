{
  "version": 2,
  "buildCommand": "cd Base-Jungle-Ui/Base-Jungle && npm install && npm run build",
  "outputDirectory": "Base-Jungle-Ui/Base-Jungle/dist",
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "https://your-render-backend.onrender.com/api/$1"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ],
  "env": {
    "VITE_API_URL": "https://your-render-backend.onrender.com"
  }
}