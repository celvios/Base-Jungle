# Base Jungle 24/7 Bot Configuration
# Copy this to backend/.env and configure your values

# ============================================================================
# BLOCKCHAIN CONFIGURATION
# ============================================================================
# RPC URL for blockchain connection (use a reliable provider like Alchemy/Infura)
RPC_URL=https://mainnet.base.org
BASE_SEPOLIA_RPC=https://sepolia.base.org
CHAIN_ID=8453

# ============================================================================
# BOT WALLET CONFIGURATION
# ============================================================================
# Private key for the keeper wallet (KEEP THIS SECURE!)
KEEPER_PRIVATE_KEY=your_keeper_private_key_here
# Fallback private key
DEPLOYER_PRIVATE_KEY=your_deployer_private_key_here

# ============================================================================
# CONTRACT ADDRESSES (Update with your deployed contracts)
# ============================================================================
CONSERVATIVE_VAULT_ADDRESS=0x986ca22e9f0A6104AAdea7C2698317A690045D13
AGGRESSIVE_VAULT_ADDRESS=0x7eD340313599090b25fA1F6F21671FE0210808E8
REFERRAL_MANAGER_ADDRESS=0xc8A84e0BF9a4C213564e858A89c8f14738aD0f15
POINTS_TRACKER_ADDRESS=0x3dEDE79F6aD12973e723e67071F17e5C42A93173
STRATEGY_CONTROLLER_ADDRESS=0x65CD6764A4f574c1F6154518519925277C6CFF81
TREASURY_MANAGER_ADDRESS=0x1F03650dB0917A0db88b7eE3aFCe2b057b4728D9
GOVERNANCE_TOKEN_ADDRESS=0x5253Bedd8A1b01f4613c2318fAB6930669B93054
TOKEN_SALE_ADDRESS=0xf809b18B34A4065693d70593f5c59B13A73f2229
DEX_AGGREGATOR_ADDRESS=0xCc549266fFa7E66086E62177c88cbDe47b23ECD7
ARBITRAGE_STRATEGY_ADDRESS=0x831369355009b828C03B824B561c8FF75bA7c371
USDC_ADDRESS=0x833589fCD6eDb6E08f4c7C32D4f71b54bdA02913

# ============================================================================
# DATABASE CONFIGURATION
# ============================================================================
DATABASE_URL=postgresql://basejungle:basejungle_prod_pass@localhost:5432/basejungle
REDIS_URL=redis://localhost:6379

# ============================================================================
# BOT CONFIGURATION
# ============================================================================
# Users to track for rebalancing (comma-separated addresses)
TRACKED_USERS=0x1234567890123456789012345678901234567890,0x0987654321098765432109876543210987654321

# Bot operation intervals (in milliseconds)
ALLOCATION_BOT_INTERVAL=30000    # 30 seconds
REBALANCE_KEEPER_INTERVAL=120000 # 2 minutes
HEALTH_CHECK_INTERVAL=60000      # 1 minute

# Gas price limits (in gwei)
MAX_GAS_PRICE_GWEI=100
EMERGENCY_GAS_PRICE_GWEI=200

# Retry configuration
MAX_RETRIES=3
RETRY_DELAY_MS=5000

# Health check configuration
MAX_HEALTH_FAILURES=5
MIN_KEEPER_BALANCE_ETH=0.001

# ============================================================================
# SERVER CONFIGURATION
# ============================================================================
NODE_ENV=production
PORT=3001
WEBSOCKET_PORT=3002

# CORS origins (comma-separated)
CORS_ORIGIN=https://your-frontend-domain.com,http://localhost:3000

# ============================================================================
# AUTHENTICATION
# ============================================================================
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production-make-it-long-and-random
SESSION_DURATION=7d
NONCE_TTL=300

# ============================================================================
# CACHE CONFIGURATION
# ============================================================================
CACHE_TTL=60
CONTRACT_CACHE_TTL=30

# ============================================================================
# RATE LIMITING
# ============================================================================
RATE_LIMIT_WINDOW=15m
RATE_LIMIT_MAX=100

# ============================================================================
# MONITORING & ALERTS (Optional)
# ============================================================================
# Telegram bot for alerts (optional)
TELEGRAM_BOT_TOKEN=your_telegram_bot_token
TELEGRAM_CHAT_ID=your_telegram_chat_id

# Sentry for error tracking (optional)
SENTRY_DSN=your_sentry_dsn

# Discord webhook for alerts (optional)
DISCORD_WEBHOOK_URL=your_discord_webhook_url

# ============================================================================
# EXTERNAL APIs (Optional)
# ============================================================================
# CoinGecko API for price feeds
COINGECKO_API_KEY=your_coingecko_api_key

# Alchemy/Infura API keys for backup RPC
ALCHEMY_API_KEY=your_alchemy_api_key
INFURA_API_KEY=your_infura_api_key

# ============================================================================
# LOGGING
# ============================================================================
LOG_LEVEL=info
LOG_FILE=logs/bot.log
ERROR_LOG_FILE=logs/error.log

# ============================================================================
# SECURITY
# ============================================================================
# Enable/disable specific bots
ALLOCATION_BOT_ENABLED=true
REBALANCE_KEEPER_ENABLED=true

# IP whitelist for admin endpoints (comma-separated)
ADMIN_IP_WHITELIST=127.0.0.1,::1

# API rate limiting
API_RATE_LIMIT=1000